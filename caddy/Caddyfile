{
	admin 0.0.0.0:2019
	metrics
}

localhost {
	tls internal

	handle /api/v1/auth/* {
		rate_limit {
			zone auth {
				key    {remote_host}
				events 10
				window 1m
			}
		}
		reverse_proxy backend:8080
	}

	handle /api* {
		reverse_proxy backend:8080
	}

	handle {
		reverse_proxy frontend:80
	}

	# rate_limit returns a 429 error → shape JSON like the Spring filters
	handle_errors {
		@rateLimited expression `{http.error.status_code} == 429`
		handle @rateLimited {
			header Content-Type application/json
			header Retry-After 60
			respond `{"error":"Too many requests. Try again later."}` 429
		}
	}
}
