{
	admin 0.0.0.0:2019
	metrics
}

localhost {
	tls internal

	handle /api/v1/auth/* {
		rate_limit {
			zone auth {
				key    {remote_host}
				events 15
				window 1m
			}
		}
		reverse_proxy backend:8080
	}

	handle /api* {
		reverse_proxy backend:8080
	}

	handle {
		reverse_proxy frontend:80
	}
}
